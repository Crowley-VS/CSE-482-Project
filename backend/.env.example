# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/economic_events_db

# Reddit API Credentials
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=EconomicEventBot/1.0

# Twitter API Credentials  
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# CORS Settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Data Collection Settings
COLLECTION_INTERVAL_HOURS=1
MAX_POSTS_PER_SUBREDDIT=100
MAX_TWEETS_PER_QUERY=100

# Economic Keywords (comma-separated)
ECONOMIC_KEYWORDS=CPI,inflation,interest rate,Fed,Federal Reserve,jobs report,unemployment,GDP,trade deficit,tariff,recession

# Subreddits to Monitor (comma-separated)
SUBREDDITS=Economics,WallStreetBets,Finance

# Event Detection Settings
SPIKE_THRESHOLD=2.5  # Standard deviations above mean
TIME_WINDOW_HOURS=24
MIN_POSTS_FOR_EVENT=5
